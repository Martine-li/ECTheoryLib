import ECTheoryLib.Operators.Mutation.IndependentBit
import ECTheoryLib.Operators.Selection.Elitist
import ECTheoryLib.Probability.Processes.Process
import Mathlib.Probability.Distributions.Uniform

/-!
# The (1+1) evolutionary algorithm

One individual is initialized uniformly, independently mutated bit by bit with
probability `1 / n`, and replaced exactly when the supplied comparison accepts
the offspring. For the usual maximizing algorithm pass `f Parent ≤ f Candidate`.
Weak comparison accepts fitness ties. Iteration time starts at initialization
(time zero); function evaluation costs and runtime bounds are separate claims.
Source: Lengler, Drift Analysis, Algorithm 2.2 with `lambda = 1` and `c = 1`,
https://cs.adelaide.edu.au/~frank/papers/TheoryBook2019-selfarchived.pdf .
-/

namespace ECTheoryLib

noncomputable section

/-- Uniform initialization among all length-n bit strings, including the unique empty string. -/
def OnePlusOneEAInit (n : Nat) : PMF (Bits n) :=
  PMF.uniformOfFintype (Bits n)

/-- Exactly one independently mutated offspring followed by elitist selection. -/
def OnePlusOneEAStep {n : Nat} (PositiveLength : 0 < n)
    (NotWorse : Bits n → Bits n → Prop) [DecidableRel NotWorse]
    (Parent : Bits n) : PMF (Bits n) :=
  (StandardBitMutation PositiveLength Parent).map
    (fun Candidate => ElitistSelect NotWorse Parent Candidate)

/-- Every possible next state comes from a possible mutation and the stated selection rule. -/
theorem OnePlusOneEAStepSupport {n : Nat} (PositiveLength : 0 < n)
    (NotWorse : Bits n → Bits n → Prop) [DecidableRel NotWorse]
    (Parent Next : Bits n) :
    Next ∈ (OnePlusOneEAStep PositiveLength NotWorse Parent).support ↔
      ∃ Candidate ∈ (StandardBitMutation PositiveLength Parent).support,
        ElitistSelect NotWorse Parent Candidate = Next := by
  exact PMF.mem_support_map_iff _ _ _

/-- Elitist selection cannot worsen an accepted comparison when that comparison is reflexive. -/
theorem OnePlusOneEAStepNotWorse {n : Nat} (PositiveLength : 0 < n)
    (NotWorse : Bits n → Bits n → Prop) [DecidableRel NotWorse]
    (ReflexiveComparison : ∀ x, NotWorse x x) (Parent Next : Bits n)
    (Possible : Next ∈ (OnePlusOneEAStep PositiveLength NotWorse Parent).support) :
    NotWorse Next Parent := by
  rcases (OnePlusOneEAStepSupport PositiveLength NotWorse Parent Next).mp Possible with
    ⟨Candidate, _MutationPossible, Selected⟩
  by_cases Accepted : NotWorse Candidate Parent
  · rw [ElitistSelectAccept NotWorse Parent Candidate Accepted] at Selected
    rw [← Selected]
    exact Accepted
  · rw [ElitistSelectReject NotWorse Parent Candidate Accepted] at Selected
    rw [← Selected]
    exact ReflexiveComparison Parent

/-- Distribution after the specified number of EA mutation iterations, with the given initial law or the standard uniform law. -/
def OnePlusOneEARun {n : Nat} (PositiveLength : 0 < n)
    (NotWorse : Bits n → Bits n → Prop) [DecidableRel NotWorse]
    (Steps : Nat) (Initial : PMF (Bits n) := OnePlusOneEAInit n) : PMF (Bits n) :=
  Probability.Evolve (OnePlusOneEAStep PositiveLength NotWorse) Initial Steps

/-- The finite-step law that freezes the first reached goal state, including a successful state at time zero. -/
def OnePlusOneEARunUntil {n : Nat} (PositiveLength : 0 < n)
    (NotWorse : Bits n → Bits n → Prop) [DecidableRel NotWorse]
    (Goal : Bits n → Prop) [DecidablePred Goal]
    (Steps : Nat) (Initial : PMF (Bits n) := OnePlusOneEAInit n) : PMF (Bits n) :=
  Probability.Evolve (Probability.StopAt (OnePlusOneEAStep PositiveLength NotWorse) Goal)
    Initial Steps

/-- Infinite trajectory measure generated by the actual EA kernel and supplied initialization. Coordinate t is the state after t mutation iterations. -/
def OnePlusOneEAProcess {n : Nat} (PositiveLength : 0 < n)
    (NotWorse : Bits n → Bits n → Prop) [DecidableRel NotWorse]
    (Initial : PMF (Bits n) := OnePlusOneEAInit n) : MeasureTheory.Measure (Nat → Bits n) :=
  Probability.PathMeasure (OnePlusOneEAStep PositiveLength NotWorse) Initial

instance OnePlusOneEAProcessIsProbability {n : Nat} (PositiveLength : 0 < n)
    (NotWorse : Bits n → Bits n → Prop) [DecidableRel NotWorse] (Initial : PMF (Bits n)) :
    MeasureTheory.IsProbabilityMeasure (OnePlusOneEAProcess PositiveLength NotWorse Initial) := by
  unfold OnePlusOneEAProcess
  infer_instance

end
end ECTheoryLib
