import ECTheoryLib.Probability.Processes.Transition
import Mathlib.Probability.Kernel.IonescuTulcea.Traj
import Mathlib.MeasureTheory.MeasurableSpace.Instances

/-!
# Infinite trajectory measures generated by discrete transitions

The initial PMF and transition kernel generate a law on complete trajectories via
mathlib's Ionescu–Tulcea construction. Marginal distributions alone would not
specify the joint law. The module connects initial and finite-prefix laws, joint
history/next-state laws, supported transition properties, and one-step integration.

The process construction requires countable states with measurable singletons.
The time-zero real-integral identity uses countable states and Mathlib's totalized
Bochner integral convention; it does not assert integrability of arbitrary observables.
The one-step real-integral bridge additionally requires finite states for integrability.
The finite-state all-time marginal identity with `Evolve` is in `PathMarginal`.
-/

namespace ECTheoryLib.Probability

open MeasureTheory ProbabilityTheory

noncomputable section

-- Countability with measurable singletons supplies the required measurability.

variable {State : Type*} [MeasurableSpace State] [Countable State]
  [MeasurableSingletonClass State]

/-- Read the current state from a finite history ending at time `t`. -/
def HistoryLast (t : Nat) (History : Finset.Iic t → State) : State :=
  
  let LastIndex : Finset.Iic t := ⟨t, Finset.mem_Iic.mpr (Nat.le_refl t)⟩
  History LastIndex

/-- Given a finite history, obtain the next-state law from its last state. -/
def HistoryKernel (Step : Transition State) (t : Nat) :
    Kernel (Finset.Iic t → State) State where
  toFun History := (Step (HistoryLast t History)).toMeasure
  measurable' := by
    -- Finite-length histories over a countable state space are themselves countable.
    exact measurable_of_countable _

instance HistoryKernelIsMarkov (Step : Transition State) (t : Nat) :
    IsMarkovKernel (HistoryKernel Step t) where
  isProbabilityMeasure History := by
    
    change IsProbabilityMeasure (Step (HistoryLast t History)).toMeasure
    infer_instance

/-- The complete trajectory law with initial PMF `Initial` and conditional transition `Step`. -/
def PathMeasure (Step : Transition State) (Initial : PMF State) :
    Measure (Nat → State) :=
  Kernel.trajMeasure Initial.toMeasure (HistoryKernel Step)

instance PathMeasureIsProbability (Step : Transition State) (Initial : PMF State) :
    IsProbabilityMeasure (PathMeasure Step Initial) := by
  unfold PathMeasure
  
  infer_instance

/-- The law of the prefix through time `t` is the finite trajectory kernel
composed with the initial-state law, under the canonical length-one encoding. -/
theorem PathMeasurePrefix (Step : Transition State) (Initial : PMF State) (t : Nat) :
    (PathMeasure Step Initial).map (Preorder.frestrictLe t) =
      (Kernel.partialTraj (X := fun _ => State) (HistoryKernel Step) 0 t) ∘ₘ
        (Initial.toMeasure.map (MeasurableEquiv.piUnique
          (fun _ : Finset.Iic 0 => State)).symm) := by
  -- Project the infinite trajectory to coordinates 0 through t.
  -- The initial state is encoded as a history containing only time zero.
  
  have PrefixMeasurable : Measurable (Preorder.frestrictLe (π := fun _ => State) t) := by
    exact Preorder.measurable_frestrictLe t
  unfold PathMeasure
  rw [Kernel.trajMeasure]
  rw [Measure.map_comp _ _ PrefixMeasurable]
  -- Trajectory consistency identifies this projection with the finite kernel.
  rw [Kernel.traj_map_frestrictLe]

/-- Compose the history law with the next-step kernel to recover the joint law
of the actual history and successor state. This specializes Ionescu–Tulcea consistency. -/
theorem PathMeasureJointLaw (Step : Transition State) (Initial : PMF State) (t : Nat) :
    (PathMeasure Step Initial).map (Preorder.frestrictLe t) ⊗ₘ HistoryKernel Step t =
      (PathMeasure Step Initial).map
        (fun Path : Nat → State => (Preorder.frestrictLe t Path, Path (t + 1))) := by
  exact Kernel.map_frestrictLe_trajMeasure_compProd_eq_map_trajMeasure
    (X := fun _ : Nat => State) (κ := HistoryKernel Step) (μ₀ := Initial.toMeasure)

/-- The time-zero coordinate has the prescribed initial distribution. -/
theorem PathMeasureInitial (Step : Transition State) (Initial : PMF State) :
    (PathMeasure Step Initial).map (fun Path : Nat → State => Path 0) =
      Initial.toMeasure := by
  let InitialIndex : Finset.Iic 0 := ⟨0, Finset.mem_Iic.mpr (Nat.le_refl 0)⟩
  have ReadInitialMeasurable :
      Measurable (fun History : Finset.Iic 0 → State => History InitialIndex) := by
    exact measurable_pi_apply InitialIndex
  have CoordinateAsHistory :
      (fun Path : Nat → State => Path 0) =
        (fun History : Finset.Iic 0 → State => History InitialIndex) ∘
          Preorder.frestrictLe 0 := by
    rfl
  rw [CoordinateAsHistory]
  rw [← Measure.map_map ReadInitialMeasurable (Preorder.measurable_frestrictLe 0)]
  -- At time zero the finite trajectory kernel is the identity.
  rw [PathMeasurePrefix Step Initial 0, Kernel.partialTraj_self, Measure.id_comp]
  rw [Measure.map_map ReadInitialMeasurable
    (MeasurableEquiv.piUnique (fun _ : Finset.Iic 0 => State)).symm.measurable]
  change Initial.toMeasure.map id = Initial.toMeasure
  exact Measure.map_id

/-- A relation holding almost surely under each transition also holds between
each pair of successive actual coordinates. Arbitrary sequences need not follow the algorithm. -/
theorem PathMeasureFollowsTransition (Step : Transition State) (Initial : PMF State)
    (Relation : State → State → Prop)
    (StepFollows : ∀ x, ∀ᵐ y ∂(Step x).toMeasure, Relation x y) (t : Nat) :
    ∀ᵐ Path ∂PathMeasure Step Initial, Relation (Path t) (Path (t + 1)) := by
  have JointFollows :
      ∀ᵐ Pair ∂((PathMeasure Step Initial).map (Preorder.frestrictLe t) ⊗ₘ
        HistoryKernel Step t), Relation (HistoryLast t Pair.1) Pair.2 := by
    apply Measure.ae_compProd_of_ae_ae
    · exact (Set.to_countable _).measurableSet
    · apply ae_of_all
      intro History
      change ∀ᵐ y ∂(Step (HistoryLast t History)).toMeasure,
        Relation (HistoryLast t History) y
      exact StepFollows (HistoryLast t History)
  rw [PathMeasureJointLaw Step Initial t] at JointFollows
  have PairMeasurable :
      Measurable (fun Path : Nat → State =>
        (Preorder.frestrictLe t Path, Path (t + 1))) := by
    exact (Preorder.measurable_frestrictLe t).prodMk (measurable_pi_apply (t + 1))
  exact ae_of_ae_map PairMeasurable.aemeasurable JointFollows

/-- One-step total expectation for finite-state trajectories.
Finite state ensures integrability of every real-valued function used here; a
countably infinite extension would require explicit integrability conditions. -/
theorem PathMeasureTransitionIntegral [Fintype State]
    (Step : Transition State) (Initial : PMF State) (t : Nat)
    (f : State → State → ℝ) :
    (∫ Path, f (Path t) (Path (t + 1)) ∂PathMeasure Step Initial) =
      ∫ Path, (∫ y, f (Path t) y ∂(Step (Path t)).toMeasure)
        ∂PathMeasure Step Initial := by
  let PairFunction : (Finset.Iic t → State) × State → ℝ :=
    fun Pair => f (HistoryLast t Pair.1) Pair.2
  have PairMeasurable :
      Measurable (fun Path : Nat → State =>
        (Preorder.frestrictLe t Path, Path (t + 1))) := by
    exact (Preorder.measurable_frestrictLe t).prodMk (measurable_pi_apply (t + 1))
  have FunctionMeasurable : Measurable PairFunction := by
    exact measurable_of_finite PairFunction
  have FunctionIntegrable :
      Integrable PairFunction ((PathMeasure Step Initial).map (Preorder.frestrictLe t) ⊗ₘ
        HistoryKernel Step t) := by
    exact Integrable.of_finite
  have HistoryFunctionMeasurable :
      Measurable (fun History : Finset.Iic t → State =>
        ∫ y, f (HistoryLast t History) y ∂(Step (HistoryLast t History)).toMeasure) := by
    exact measurable_of_finite _
  calc
    (∫ Path, f (Path t) (Path (t + 1)) ∂PathMeasure Step Initial) =
        ∫ Pair, PairFunction Pair ∂((PathMeasure Step Initial).map
          (fun Path : Nat → State => (Preorder.frestrictLe t Path, Path (t + 1)))) := by
      rw [integral_map_of_stronglyMeasurable PairMeasurable
        FunctionMeasurable.stronglyMeasurable]
      rfl
    _ = ∫ Pair, PairFunction Pair
        ∂((PathMeasure Step Initial).map (Preorder.frestrictLe t) ⊗ₘ
          HistoryKernel Step t) := by
      rw [PathMeasureJointLaw Step Initial t]
    _ = ∫ History, (∫ y, f (HistoryLast t History) y
        ∂(Step (HistoryLast t History)).toMeasure)
        ∂((PathMeasure Step Initial).map (Preorder.frestrictLe t)) := by
      rw [Measure.integral_compProd FunctionIntegrable]
      rfl
    _ = ∫ Path, (∫ y, f (Path t) y ∂(Step (Path t)).toMeasure)
        ∂PathMeasure Step Initial := by
      rw [integral_map_of_stronglyMeasurable (Preorder.measurable_frestrictLe t)
        HistoryFunctionMeasurable.stronglyMeasurable]
      rfl

end

noncomputable section

variable {State : Type*} [Countable State] [MeasurableSpace State]
  [MeasurableSingletonClass State]

/-- A pure initial law places the time-zero coordinate at that state almost surely. -/
theorem PathMeasureInitialPure (Step : Transition State) (InitialState : State) :
    ∀ᵐ Path ∂PathMeasure Step (PMF.pure InitialState), Path 0 = InitialState := by
  have InitialIsFixed :
      ∀ᵐ x ∂(PMF.pure InitialState).toMeasure, x = InitialState := by
    rw [PMF.toMeasure_pure]
    apply (ae_dirac_iff (measurableSet_singleton InitialState)).mpr
    rfl
  have MappedInitialIsFixed :
      ∀ᵐ x ∂(PathMeasure Step (PMF.pure InitialState)).map
        (fun Path : Nat → State => Path 0), x = InitialState := by
    rw [PathMeasureInitial Step (PMF.pure InitialState)]
    exact InitialIsFixed
  exact ae_of_ae_map (measurable_pi_apply 0).aemeasurable MappedInitialIsFixed

/-- A function of the initial coordinate has its expectation under the initial PMF. -/
theorem PathMeasureInitialIntegral (Step : Transition State) (Initial : PMF State)
    (f : State → ℝ) :
    (∫ Path, f (Path 0) ∂PathMeasure Step Initial) =
      ∫ x, f x ∂Initial.toMeasure := by
  have FunctionMeasurable : Measurable f := by
    exact measurable_of_countable f
  rw [← integral_map_of_stronglyMeasurable (measurable_pi_apply 0)
    FunctionMeasurable.stronglyMeasurable]
  rw [PathMeasureInitial Step Initial]

end
end ECTheoryLib.Probability
