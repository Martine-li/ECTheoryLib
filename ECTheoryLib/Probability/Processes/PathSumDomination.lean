import ECTheoryLib.Probability.StochasticOrder.ConditionalStochasticDomination
import ECTheoryLib.Probability.Processes.Process

/-!
# Distribution bounds for accumulated trajectory costs

The history law is generated by the actual transition PMF. Conditional kernels
are compared before adding a measurable function of that full history. The
result concerns a finite horizon, not a hitting time or a restart theorem.
-/

namespace ECTheoryLib.Probability
open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal
noncomputable section

/-- Accumulate values after transitions 1 through t, excluding initialization. -/
def HistoryPotentialSum {State : Type*} (V : State → ℝ) (t : ℕ)
    (h : Finset.Iic t → State) : ℝ :=
  ∑ i : Fin t, V (h ⟨i + 1, Finset.mem_Iic.mpr (by omega)⟩)

/-- The finite-history cost agrees exactly with the trajectory cost. -/
theorem HistoryPotentialSumPrefix {State : Type*} (V : State → ℝ) (t : ℕ)
    (Path : ℕ → State) :
    HistoryPotentialSum V t (Preorder.frestrictLe t Path) =
      ∑ i ∈ Finset.range t, V (Path (i + 1)) := by
  exact Fin.sum_univ_eq_sum_range (fun i => V (Path (i + 1))) t

/-- A local kernel comparison yields one step of an accumulated-cost comparison.
The joint history/next-state law is the actual Ionescu-Tulcea trajectory law. -/
theorem PathPotentialSumStepBound {State : Type*} [MeasurableSpace State]
    [Countable State] [MeasurableSingletonClass State]
    (Step : Transition State) (Initial : PMF State) (V : State → ℝ) (t : ℕ)
    (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (LocalBound : ∀ᵐ Path ∂PathMeasure Step Initial,
      StochasticDominated ((Step (Path t)).toMeasure.map V) ν) :
    StochasticDominated
      ((PathMeasure Step Initial).map (fun Path => ∑ i ∈ Finset.range (t + 1), V (Path (i + 1))))
      (((PathMeasure Step Initial).map (fun Path => ∑ i ∈ Finset.range t, V (Path (i + 1)))) ∗ ν) := by
  let μ := PathMeasure Step Initial
  let Hst := Preorder.frestrictLe (π := fun _ => State) t
  have MeasurableHistory : Measurable Hst := Preorder.measurable_frestrictLe t
  have HistoryProbability : IsProbabilityMeasure (μ.map Hst) :=
    Measure.isProbabilityMeasure_map MeasurableHistory.aemeasurable
  have MeasurableV : Measurable V := measurable_of_countable V
  have MeasurableSum : Measurable (HistoryPotentialSum V t) := measurable_of_countable _
  have BoundOnHistories : ∀ᵐ h ∂μ.map Hst,
      StochasticDominated (((HistoryKernel Step t).map V) h) ν := by
    apply (ae_map_iff MeasurableHistory.aemeasurable (Set.to_countable _).measurableSet).mpr
    filter_upwards [LocalBound] with Path Bound
    rw [Kernel.map_apply _ MeasurableV]
    exact Bound
  have Compared := StochasticDominatedKernelAdd (μ.map Hst)
    ((HistoryKernel Step t).map V) (Kernel.const _ ν) (HistoryPotentialSum V t)
    MeasurableSum BoundOnHistories
  rw [ConstantKernelAdditionLaw _ ν _ MeasurableSum,
    Measure.compProd_map MeasurableV, PathMeasureJointLaw Step Initial t] at Compared
  have MeasurableAdd : Measurable (fun p : (Finset.Iic t → State) × ℝ =>
      HistoryPotentialSum V t p.1 + p.2) :=
    (MeasurableSum.comp measurable_fst).add measurable_snd
  rw [Measure.map_map MeasurableAdd (measurable_id.prodMap MeasurableV)] at Compared
  have MeasurableJoint : Measurable (fun Path : ℕ → State => (Hst Path, Path (t + 1))) :=
    MeasurableHistory.prodMk (measurable_pi_apply (t + 1))
  rw [Measure.map_map (MeasurableAdd.comp (measurable_id.prodMap MeasurableV))
    MeasurableJoint, Measure.map_map MeasurableSum MeasurableHistory] at Compared
  simpa only [Function.comp_def, Prod.map_apply, id_eq, Hst, μ, HistoryPotentialSumPrefix,
    Finset.sum_range_succ] using Compared

/-- Compare a trajectory cost with independent reference increments.
The local bound is verified on actual reachable states almost surely. -/
theorem PathPotentialSumStochasticDominated {State Ω' : Type*}
    [MeasurableSpace State] [Countable State] [MeasurableSingletonClass State]
    [MeasurableSpace Ω'] (Step : Transition State) (Initial : PMF State) (V : State → ℝ)
    (Q : Measure Ω') [IsProbabilityMeasure Q] (Y : ℕ → Ω' → ℝ)
    (MeasurableY : ∀ i, Measurable (Y i)) (IndependentY : iIndepFun Y Q) (n : ℕ)
    (LocalBound : ∀ t < n, ∀ᵐ Path ∂PathMeasure Step Initial,
      StochasticDominated ((Step (Path t)).toMeasure.map V) (Q.map (Y t))) :
    StochasticDominated
      ((PathMeasure Step Initial).map (fun Path => ∑ i ∈ Finset.range n, V (Path (i + 1))))
      (Q.map (fun ω => ∑ i ∈ Finset.range n, Y i ω)) := by
  induction n with
  | zero =>
      simp only [Finset.range_zero, Finset.sum_empty, Measure.map_const, measure_univ, one_smul]
      exact StochasticDominatedRefl _
  | succ n InductionHypothesis =>
      have Previous := InductionHypothesis (fun t ht => LocalBound t (Nat.lt_succ_of_lt ht))
      have MeasurableSumX : Measurable (fun Path : ℕ → State =>
          ∑ i ∈ Finset.range n, V (Path (i + 1))) :=
        Finset.measurable_sum _ (fun i _ => (measurable_of_countable V).comp
          (measurable_pi_apply (i + 1)))
      have MeasurableSumY : Measurable (fun ω => ∑ i ∈ Finset.range n, Y i ω) :=
        Finset.measurable_sum _ (fun i _ => MeasurableY i)
      have ProbabilityX : IsProbabilityMeasure ((PathMeasure Step Initial).map
          (fun Path => ∑ i ∈ Finset.range n, V (Path (i + 1)))) :=
        Measure.isProbabilityMeasure_map MeasurableSumX.aemeasurable
      have ProbabilityY : IsProbabilityMeasure (Q.map (fun ω => ∑ i ∈ Finset.range n, Y i ω)) :=
        Measure.isProbabilityMeasure_map MeasurableSumY.aemeasurable
      have ProbabilityNext : IsProbabilityMeasure (Q.map (Y n)) :=
        Measure.isProbabilityMeasure_map (MeasurableY n).aemeasurable
      have OneStep := PathPotentialSumStepBound Step Initial V n (Q.map (Y n))
        (LocalBound n (Nat.lt_succ_self n))
      have ConvolutionBound := StochasticDominatedConv _ _ _ _ Previous
        (StochasticDominatedRefl (Q.map (Y n)))
      have Compared := StochasticDominatedTrans OneStep ConvolutionBound
      have IndependentSum : IndepFun (fun ω => ∑ i ∈ Finset.range n, Y i ω) (Y n) Q := by
        have IndependentFunctions := IndependentY.indepFun_finsetSum_of_notMem
          MeasurableY (i := n) Finset.notMem_range_self
        have SumFunction : (∑ i ∈ Finset.range n, Y i) =
            fun ω => ∑ i ∈ Finset.range n, Y i ω := by
          funext ω
          exact Finset.sum_apply _ _ _
        rw [SumFunction] at IndependentFunctions
        exact IndependentFunctions
      have SumLaw := IndependentSum.map_add_eq_map_conv_map MeasurableSumY (MeasurableY n)
      rw [← SumLaw] at Compared
      change StochasticDominated _
        (Q.map (fun ω => (∑ i ∈ Finset.range n, Y i ω) + Y n ω)) at Compared
      simpa only [Finset.sum_range_succ] using Compared

end
end ECTheoryLib.Probability
